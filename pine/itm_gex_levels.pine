//@version=6
// =============================================================================
//  ITM GEX Levels + 0DTE Signal Engine
//
//  Draws dealer gamma-exposure levels (call wall / put wall / gamma flip /
//  control node) as horizontal rays and infers the gamma regime from where
//  price sits relative to the flip.
//
//  Signals come from 15 confluences — trend, momentum, relative volume,
//  cumulative delta, VWAP, liquidity sweeps, displacement, gamma-regime fit,
//  the control-node magnet, room to the next level, the opening range, the
//  expected-move band, higher-timeframe trend, market context and delta
//  divergence. Each casts a weighted bull/bear vote; confidence is how strongly
//  they agree, and a trade needs both a confident lean and a minimum number of
//  confluences behind it. Entry, stop, TP1 and TP2 are drawn and tracked to
//  their exit, with targets snapped to real GEX levels.
//
//  Levels come from tools/gex_engine.py (paste the blob into "GEX blob"), or
//  run it with --serve for a live dashboard that refreshes through the session.
//  With no blob the indicator falls back to auto levels derived from price,
//  volume profile and VWAP so it still works on any symbol.
// =============================================================================
indicator("ITM GEX Levels + 0DTE Signal Engine", "ITM·GEX", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

G_LVL  = "1 · GEX levels"
G_PROF = "2 · GEX profile"
G_AUTO = "3 · Auto levels (fallback)"
G_SIG  = "4 · Signal engine"
G_RISK = "5 · Targets & risk"
G_UI   = "6 · Display"

// ── GEX level inputs ─────────────────────────────────────────────────────────
i_blob = input.text_area("", "GEX blob",
     tooltip = "Paste from gex_engine.py, e.g.\n" +
               "flip:757.2,cw:762,pw:750,cn:758,cw2:765,pw2:745,net:1.24,em:4.8",
     group = G_LVL)
i_showFlip = input.bool(true,  "Gamma flip (HVL)",  group = G_LVL, inline = "a")
i_showWall = input.bool(true,  "Call / put walls",  group = G_LVL, inline = "a")
i_showNode = input.bool(true,  "Control node",      group = G_LVL, inline = "b")
i_showEM   = input.bool(true,  "Expected move",     group = G_LVL, inline = "b")

// ── Per-strike profile (optional, mirrors the GEX panel) ─────────────────────
i_prof = input.text_area("", "Strike profile",
     tooltip = "strike=gex pairs in $M, comma separated:\n750=-2.76,755=1.24,757.5=10.31",
     group = G_PROF)
i_profShow  = input.bool(true, "Draw profile rays", group = G_PROF)
i_profMax   = input.int(24, "Max strikes", minval = 2, maxval = 40, group = G_PROF)
i_profWidth = input.int(6,  "Max ray width", minval = 1, maxval = 10, group = G_PROF)

// ── Auto-level fallback ──────────────────────────────────────────────────────
i_autoOn   = input.bool(true, "Use auto levels when blob is empty", group = G_AUTO)
i_showPDHL = input.bool(true, "Prior day high/low", group = G_AUTO)
i_showONHL = input.bool(true, "Overnight high/low", group = G_AUTO)
i_showVWAP = input.bool(true, "VWAP + 1σ bands",    group = G_AUTO)

// ── Signal engine ────────────────────────────────────────────────────────────
i_sigOn    = input.bool(true, "Enable signals", group = G_SIG)
i_rthOnly  = input.bool(true, "Regular hours only", group = G_SIG)
i_skipOpen = input.int(2,  "Skip first N bars",  minval = 0, maxval = 12, group = G_SIG)
i_skipEOD  = input.int(2,  "Skip last N bars",   minval = 0, maxval = 12, group = G_SIG)
i_minConf  = input.int(60, "Min confidence %", minval = 20, maxval = 95, step = 5, group = G_SIG,
     tooltip = "Confidence is the weighted agreement across all confluences. 60 ≈ grade B.")
i_minAgree = input.int(5, "Min confluences agreeing", minval = 2, maxval = 12, group = G_SIG)
i_cooldown = input.int(5, "Cooldown bars", minval = 0, maxval = 50, group = G_SIG)
i_regimeF  = input.bool(true, "Regime filter", group = G_SIG,
     tooltip = "In positive gamma, block longs pressed into the call wall and shorts pressed into the put wall (dealers suppress moves there).")

// ── Confluence weights ───────────────────────────────────────────────────────
// Each confluence casts a bull/bear/neutral vote; confidence is the weighted
// agreement between them. Set a weight to 0 to switch that confluence off.
G_CONF = "4b · Confluence weights"
w_trend  = input.float(12, "Trend (EMA stack)",      minval = 0, maxval = 30, group = G_CONF, inline = "a")
w_mom    = input.float(10, "Momentum (RSI)",         minval = 0, maxval = 30, group = G_CONF, inline = "a")
w_rvol   = input.float(8,  "Relative volume",        minval = 0, maxval = 30, group = G_CONF, inline = "b")
w_delta  = input.float(10, "Cumulative delta",       minval = 0, maxval = 30, group = G_CONF, inline = "b")
w_vwap   = input.float(8,  "VWAP position",          minval = 0, maxval = 30, group = G_CONF, inline = "c")
w_sweep  = input.float(12, "Liquidity sweep",        minval = 0, maxval = 30, group = G_CONF, inline = "c")
w_disp   = input.float(8,  "Displacement",           minval = 0, maxval = 30, group = G_CONF, inline = "d")
w_gamma  = input.float(14, "Gamma regime fit",       minval = 0, maxval = 30, group = G_CONF, inline = "d")
w_magnet = input.float(10, "Control-node magnet",    minval = 0, maxval = 30, group = G_CONF, inline = "e")
w_room   = input.float(8,  "Room to next level",     minval = 0, maxval = 30, group = G_CONF, inline = "e")
w_orb    = input.float(10, "Opening range",          minval = 0, maxval = 30, group = G_CONF, inline = "f")
w_em     = input.float(10, "Expected-move band",     minval = 0, maxval = 30, group = G_CONF, inline = "f")
w_htf    = input.float(12, "Higher timeframe trend", minval = 0, maxval = 30, group = G_CONF, inline = "g")
w_ctx    = input.float(8,  "Market context (SPY)",   minval = 0, maxval = 30, group = G_CONF, inline = "g")
w_div    = input.float(10, "Delta divergence",       minval = 0, maxval = 30, group = G_CONF, inline = "h")

i_htf    = input.timeframe("15", "Higher timeframe", group = G_CONF)
i_ctxSym = input.symbol("AMEX:SPY", "Context symbol", group = G_CONF)

i_emaFast = input.int(9,  "EMA fast", minval = 2, group = G_SIG, inline = "m")
i_emaSlow = input.int(21, "EMA slow", minval = 3, group = G_SIG, inline = "m")
i_rvolLen = input.int(20, "RVOL length", minval = 5, group = G_SIG, inline = "v")
i_cvdLen  = input.int(6,  "Delta slope bars", minval = 2, group = G_SIG, inline = "v")
i_swing   = input.int(10, "Sweep lookback", minval = 3, group = G_SIG, inline = "l")
i_orbMin  = input.int(30, "Opening range (min)", minval = 5, maxval = 120, step = 5, group = G_SIG, inline = "l")

// ── Targets & risk ───────────────────────────────────────────────────────────
i_minRR    = input.float(1.3, "Min reward:risk", minval = 0.2, step = 0.1, group = G_RISK)
i_stopATR  = input.float(1.1, "Stop (ATR mult)", minval = 0.2, step = 0.1, group = G_RISK)
i_maxRiskATR = input.float(1.8, "Max risk (ATR mult)", minval = 0.3, step = 0.1, group = G_RISK,
     tooltip = "Caps the stop distance so a far-away structural level can't create an oversized loss.")
i_manageOn = input.bool(true, "Track trades on chart", group = G_RISK)
i_beAtTp1  = input.bool(true, "Move stop to breakeven at TP1", group = G_RISK)
i_exitEOD  = input.bool(true, "Flatten at session close (0DTE)", group = G_RISK)
i_exitFlip = input.bool(false, "Exit if score flips against the trade", group = G_RISK)
i_pinGuard = input.bool(true, "Block new entries pinned to the control node", group = G_RISK,
     tooltip = "Late in the session in positive gamma, price parked on the control node tends to stay there. Suppresses low-quality entries.")
i_drawProj = input.bool(true, "Draw target projection", group = G_RISK)
i_showStats = input.bool(true, "Session stats table", group = G_RISK)

// ── Display ──────────────────────────────────────────────────────────────────
i_back = input.int(60, "Ray look-back bars", minval = 0, maxval = 500, group = G_UI)
i_fwd  = input.int(18, "Ray extension bars", minval = 1, maxval = 200, group = G_UI)
i_hud       = input.bool(true, "Show HUD", group = G_UI)
i_hudDetail = input.bool(false, "HUD · list active confluences", group = G_UI)
i_minimal   = input.bool(false, "Minimal mode", group = G_UI,
     tooltip = "Draws only the flip, the two main walls and the control node. Hides secondary walls, expected-move band, overnight levels, VWAP bands and the strike profile.")
c_call = input.color(#2962ff, "Call wall / +GEX", group = G_UI, inline = "c1")
c_put  = input.color(#ff2d3f, "Put wall / -GEX",  group = G_UI, inline = "c1")
c_flip = input.color(#e8eaed, "Gamma flip",       group = G_UI, inline = "c2")
c_node = input.color(#ffd54a, "Control node",     group = G_UI, inline = "c2")

// =============================================================================
//  Blob parsing
// =============================================================================
// Pasting from a terminal drags in newlines, and text_area keeps them. A stray
// newline on the front would silently break the first key, so strip all
// whitespace before parsing.
f_clean(string s) =>
    t = str.replace_all(s, " ", "")
    t := str.replace_all(t, "\n", "")
    t := str.replace_all(t, "\r", "")
    t := str.replace_all(t, "\t", "")
    t

f_key(string blob, string key) =>
    float out = na
    if str.length(blob) > 0
        parts = str.split(f_clean(blob), ",")
        for i = 0 to array.size(parts) - 1
            kv = str.split(array.get(parts, i), ":")
            if array.size(kv) == 2 and array.get(kv, 0) == key
                out := str.tonumber(array.get(kv, 1))
    out

var float gexFlip = f_key(i_blob, "flip")
var float gexCW   = f_key(i_blob, "cw")
var float gexPW   = f_key(i_blob, "pw")
var float gexCN   = f_key(i_blob, "cn")
var float gexCW2  = f_key(i_blob, "cw2")
var float gexPW2  = f_key(i_blob, "pw2")
var float gexNet  = f_key(i_blob, "net")
var float gexEM   = f_key(i_blob, "em")

var bool hasGex = not na(gexFlip) or not na(gexCW) or not na(gexPW)

// Per-strike profile: "strike=gex" pairs
var float[] pStrike = array.new<float>()
var float[] pGex    = array.new<float>()
var float   pMaxAbs = 0.0

if barstate.isfirst and str.length(i_prof) > 0
    rows = str.split(f_clean(i_prof), ",")
    for i = 0 to math.min(array.size(rows), i_profMax) - 1
        kv = str.split(array.get(rows, i), "=")
        if array.size(kv) == 2
            k = str.tonumber(array.get(kv, 0))
            v = str.tonumber(array.get(kv, 1))
            if not na(k) and not na(v)
                array.push(pStrike, k)
                array.push(pGex, v)
                pMaxAbs := math.max(pMaxAbs, math.abs(v))

// =============================================================================
//  Auto levels
// =============================================================================
newDay = timeframe.change("D")
atr    = ta.atr(14)
vwap   = ta.vwap(hlc3)
vwapSd = ta.stdev(close - vwap, 40)

// Prior day / overnight
var float pdh = na
var float pdl = na
var float dHi = na
var float dLo = na
if newDay
    pdh := dHi
    pdl := dLo
    dHi := high
    dLo := low
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)

inRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
var float onh = na
var float onl = na
if newDay
    onh := na
    onl := na
if not inRth
    onh := na(onh) ? high : math.max(onh, high)
    onl := na(onl) ? low  : math.min(onl, low)

// Session volume profile → point of control (auto "control node")
var map<int, float> vp = map.new<int, float>()
var float bkt = na
if newDay or na(bkt)
    map.clear(vp)
    bkt := math.max(syminfo.mintick, math.round(nz(atr, close * 0.002) * 0.15 / syminfo.mintick) * syminfo.mintick)
int vpKey = int(math.round(hlc3 / bkt))
map.put(vp, vpKey, nz(map.get(vp, vpKey)) + volume)

f_poc() =>
    float best = na
    float bestV = 0.0
    ks = map.keys(vp)
    // `for 0 to size-1` would count downward on an empty map and index out of range
    if array.size(ks) > 0
        for i = 0 to array.size(ks) - 1
            k = array.get(ks, i)
            v = nz(map.get(vp, k))
            if v > bestV
                bestV := v
                best := k * bkt
    best
poc = barstate.islast ? f_poc() : na

// Effective levels: GEX when supplied, otherwise auto proxies
flipLvl = hasGex ? gexFlip : (i_autoOn ? vwap : na)
cwLvl   = hasGex ? gexCW   : (i_autoOn ? math.max(nz(pdh, dHi), dHi) : na)
pwLvl   = hasGex ? gexPW   : (i_autoOn ? math.min(nz(pdl, dLo), dLo) : na)
cnLvl   = hasGex ? gexCN   : (i_autoOn ? poc : na)

// Expected-move envelope around the session open — also a target candidate,
// so it has to exist before the trade logic below.
var float sessOpen = na
if newDay
    sessOpen := open
emUp = na(gexEM) or na(sessOpen) ? na : sessOpen + gexEM
emDn = na(gexEM) or na(sessOpen) ? na : sessOpen - gexEM

// =============================================================================
//  Regime
// =============================================================================
// Above the flip dealers are net long gamma: they sell rallies and buy dips,
// which compresses range and pins price toward the control node.
// Below it they are short gamma: hedging amplifies moves and trends extend.
posGamma = not na(flipLvl) and close > flipLvl
negGamma = not na(flipLvl) and close < flipLvl
// Without a blob the "flip" is only VWAP, so the bias is a mean-reversion proxy
// and must not be reported as a gamma regime — there is no options data behind it.
regime = not hasGex
     ? (na(flipLvl) ? "NO DATA · price-only"
        : posGamma ? "AUTO · above VWAP (no GEX)" : "AUTO · below VWAP (no GEX)")
     : posGamma ? "POSITIVE γ · mean-revert / pin"
     : negGamma ? "NEGATIVE γ · trend / expand" : "NO GEX · price-only"

// =============================================================================
//  Signal components  (each returns roughly -1 … +1)
// =============================================================================
// =============================================================================
//  Confluence engine
// =============================================================================
// Fifteen independent reads on the tape. Each casts a bull / bear / neutral
// vote and confidence is how strongly they agree once weighted, so a signal
// needs both a confident lean and enough separate confluences behind it.

// Session bar count — the opening range and the session filters both need it.
var int rthBar = 0
rthBar := inRth ? rthBar + 1 : 0
tfMin    = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
rthTotal = math.round(390.0 / tfMin)

f_clamp(float v) => math.max(-1.0, math.min(1.0, v))

// ── Raw measures ─────────────────────────────────────────────────────────────
emaF = ta.ema(close, i_emaFast)
emaS = ta.ema(close, i_emaSlow)
rsi  = ta.rsi(close, 14)

rng      = math.max(high - low, syminfo.mintick)
barDelta = (2 * (close - low) / rng - 1) * volume
var float cvd = 0.0
cvd := newDay ? barDelta : cvd + barDelta
cvdSlope = cvd - cvd[i_cvdLen]
cvdNorm  = ta.stdev(cvdSlope, 50)
rvol     = volume / math.max(ta.sma(volume, i_rvolLen), 1)

swHi = ta.highest(high, i_swing)[1]
swLo = ta.lowest(low, i_swing)[1]
sweepHi = high > swHi and close < swHi          // ran stops above, closed back in
sweepLo = low  < swLo and close > swLo          // ran stops below, closed back in
disp    = atr > 0 ? (close - open) / atr : 0.0

// Opening range — the first N minutes frame the day for 0DTE.
orbBars = math.max(1, int(math.round(i_orbMin / tfMin)))
var float orbHi = na
var float orbLo = na
if newDay
    orbHi := na
    orbLo := na
if inRth and rthBar <= orbBars
    orbHi := na(orbHi) ? high : math.max(orbHi, high)
    orbLo := na(orbLo) ? low  : math.min(orbLo, low)

// Higher-timeframe trend, read from the *previous completed* HTF bar so the
// vote never repaints while the current HTF candle is still forming.
htfF = request.security(syminfo.tickerid, i_htf, ta.ema(close, i_emaFast)[1],
     lookahead = barmerge.lookahead_off)
htfS = request.security(syminfo.tickerid, i_htf, ta.ema(close, i_emaSlow)[1],
     lookahead = barmerge.lookahead_off)

// Market context. On a SPY chart this just echoes the VWAP confluence.
ctxPx   = request.security(i_ctxSym, timeframe.period, close,
     lookahead = barmerge.lookahead_off)
ctxVwap = request.security(i_ctxSym, timeframe.period, ta.vwap(hlc3),
     lookahead = barmerge.lookahead_off)

// Delta divergence — price makes a new extreme, order flow does not follow.
newPxHi  = close > ta.highest(close, 10)[1]
newPxLo  = close < ta.lowest(close, 10)[1]
newCvdHi = cvd   > ta.highest(cvd, 10)[1]
newCvdLo = cvd   < ta.lowest(cvd, 10)[1]
bearDiv  = newPxHi and not newCvdHi
bullDiv  = newPxLo and not newCvdLo

// ── Level context ────────────────────────────────────────────────────────────
f_nearestAbove(float a, float b, float c, float d) =>
    float r = na
    if not na(a) and a > close
        r := na(r) ? a : math.min(r, a)
    if not na(b) and b > close
        r := na(r) ? b : math.min(r, b)
    if not na(c) and c > close
        r := na(r) ? c : math.min(r, c)
    if not na(d) and d > close
        r := na(r) ? d : math.min(r, d)
    r
f_nearestBelow(float a, float b, float c, float d) =>
    float r = na
    if not na(a) and a < close
        r := na(r) ? a : math.max(r, a)
    if not na(b) and b < close
        r := na(r) ? b : math.max(r, b)
    if not na(c) and c < close
        r := na(r) ? c : math.max(r, c)
    if not na(d) and d < close
        r := na(r) ? d : math.max(r, d)
    r

resLvl = f_nearestAbove(cwLvl, gexCW2, cnLvl, flipLvl)
supLvl = f_nearestBelow(pwLvl, gexPW2, cnLvl, flipLvl)
dRes   = na(resLvl) or atr <= 0 ? na : (resLvl - close) / atr
dSup   = na(supLvl) or atr <= 0 ? na : (close - supLvl) / atr

magnet     = na(cnLvl) ? na : cnLvl
magnetPull = na(magnet) or atr <= 0 ? 0.0 : f_clamp((magnet - close) / (atr * 3))

// ── Voting ───────────────────────────────────────────────────────────────────
cNames = array.new<string>()
cVotes = array.new<float>()
cWts   = array.new<float>()

f_vote(string[] nmA, float[] vA, float[] wA, string nm, float v, float w) =>
    if w > 0 and not na(v)
        array.push(nmA, nm)
        array.push(vA, math.max(-1.0, math.min(1.0, v)))
        array.push(wA, w)

// 1 trend, 2 momentum
f_vote(cNames, cVotes, cWts, "Trend", atr > 0 ? (emaF - emaS) / (atr * 0.6) : 0.0, w_trend)
f_vote(cNames, cVotes, cWts, "Momentum", (rsi - 50) / 20.0, w_mom)
// 3 participation confirms the bar's own direction
f_vote(cNames, cVotes, cWts, "RVOL",
     rvol > 1.15 ? (close > open ? 1.0 : -1.0) * math.min((rvol - 1.0) / 1.5, 1.0) : 0.0, w_rvol)
// 4 order flow
f_vote(cNames, cVotes, cWts, "Delta", cvdNorm > 0 ? cvdSlope / (cvdNorm * 1.2) : 0.0, w_delta)
// 5 value area
f_vote(cNames, cVotes, cWts, "VWAP", atr > 0 ? (close - vwap) / (atr * 1.2) : 0.0, w_vwap)
// 6 a failed sweep is the highest-quality single tell on this list
f_vote(cNames, cVotes, cWts, "Sweep", sweepLo ? 1.0 : sweepHi ? -1.0 : 0.0, w_sweep)
// 7 conviction of the current bar
f_vote(cNames, cVotes, cWts, "Displacement", disp / 1.2, w_disp)
// 8 regime bias: short gamma amplifies the prevailing move, long gamma pulls to the node
f_vote(cNames, cVotes, cWts, "Gamma fit",
     negGamma and atr > 0 ? f_clamp((close - vwap) / (atr * 1.5))
     : posGamma ? magnetPull : 0.0, w_gamma)
// 9 the magnet itself
f_vote(cNames, cVotes, cWts, "Magnet", magnetPull, w_magnet)
// 10 asymmetry of space — far ceiling and near floor favours longs
f_vote(cNames, cVotes, cWts, "Room", (nz(dRes, 3.0) - nz(dSup, 3.0)) / 2.0, w_room)
// 11 opening range
f_vote(cNames, cVotes, cWts, "Opening range",
     na(orbHi) or na(orbLo) ? 0.0 : close > orbHi ? 1.0 : close < orbLo ? -1.0 : 0.0, w_orb)
// 12 expected-move exhaustion — the edges of the band tend to reject on 0DTE
f_vote(cNames, cVotes, cWts, "EM band",
     not na(emUp) and close >= emUp ? -1.0 : not na(emDn) and close <= emDn ? 1.0 : 0.0, w_em)
// 13 higher timeframe
f_vote(cNames, cVotes, cWts, "HTF trend",
     na(htfF) or na(htfS) or atr <= 0 ? 0.0 : (htfF - htfS) / (atr * 0.8), w_htf)
// 14 broad market
f_vote(cNames, cVotes, cWts, "Context",
     na(ctxPx) or na(ctxVwap) ? 0.0 : ctxPx > ctxVwap ? 0.6 : -0.6, w_ctx)
// 15 divergence
f_vote(cNames, cVotes, cWts, "Divergence", bullDiv ? 1.0 : bearDiv ? -1.0 : 0.0, w_div)

// ── Tally ────────────────────────────────────────────────────────────────────
float bullW = 0.0
float bearW = 0.0
float totW  = 0.0
int   nBull = 0
int   nBear = 0
if array.size(cVotes) > 0
    for i = 0 to array.size(cVotes) - 1
        v = array.get(cVotes, i)
        w = array.get(cWts, i)
        totW += w
        if v > 0.15
            bullW += w * v
            nBull += 1
        else if v < -0.15
            bearW += w * (-v)
            nBear += 1

// score keeps the -1…+1 convention the rest of the script uses
score      = totW > 0 ? (bullW - bearW) / totW : 0.0
confidence = math.round(math.abs(score) * 100)
nAgree     = score > 0 ? nBull : nBear
grade      = confidence >= 75 ? "A" : confidence >= 60 ? "B" : confidence >= 45 ? "C" : "D"
thrScore   = i_minConf / 100.0

// =============================================================================
//  Signal gating
// =============================================================================

sessionOk = not i_rthOnly or inRth
openOk    = inRth ? rthBar > i_skipOpen : not i_rthOnly
eodOk     = inRth ? rthBar <= rthTotal - i_skipEOD : not i_rthOnly

// ── Trade construction ───────────────────────────────────────────────────────
// Targets are real GEX levels, not ATR guesses: price tends to travel between
// walls and stall at them, so the levels themselves are the natural exits.
f_levelPool() =>
    arr = array.new<float>()
    if not na(cwLvl)
        array.push(arr, cwLvl)
    if not na(gexCW2)
        array.push(arr, gexCW2)
    if not na(pwLvl)
        array.push(arr, pwLvl)
    if not na(gexPW2)
        array.push(arr, gexPW2)
    if not na(cnLvl)
        array.push(arr, cnLvl)
    if not na(flipLvl)
        array.push(arr, flipLvl)
    if not na(emUp)
        array.push(arr, emUp)
    if not na(emDn)
        array.push(arr, emDn)
    if not hasGex
        // auto mode: fall back to structural levels so targets still exist
        if not na(pdh)
            array.push(arr, pdh)
        if not na(pdl)
            array.push(arr, pdl)
        if not na(onh)
            array.push(arr, onh)
        if not na(onl)
            array.push(arr, onl)
    array.sort(arr, order.ascending)
    arr

// The nth level beyond `px` in the trade's direction, ignoring anything closer
// than minGap so TP1 is never a few ticks away.
f_targetN(float px, bool up, int n, float minGap) =>
    pool = f_levelPool()
    float out = na
    int found = 0
    if array.size(pool) > 0
        if up
            for i = 0 to array.size(pool) - 1
                v = array.get(pool, i)
                if v > px + minGap and na(out)
                    found += 1
                    if found == n
                        out := v
        else
            for i = array.size(pool) - 1 to 0
                v = array.get(pool, i)
                if v < px - minGap and na(out)
                    found += 1
                    if found == n
                        out := v
    out

minGap = atr * 0.35
longTp1  = f_targetN(close, true,  1, minGap)
longTp2  = f_targetN(close, true,  2, minGap)
shortTp1 = f_targetN(close, false, 1, minGap)
shortTp2 = f_targetN(close, false, 2, minGap)

// No level in range — fall back to a measured move so a trade is still definable.
longTgt  = na(longTp1)  ? close + atr * 2.0 : longTp1
shortTgt = na(shortTp1) ? close - atr * 2.0 : shortTp1

// Stop sits beyond structure, then risk is capped so a distant level can't
// create an oversized loss.
rawLongStop  = math.min(ta.lowest(low, 5), close - atr * i_stopATR)
rawShortStop = math.max(ta.highest(high, 5), close + atr * i_stopATR)
longStop  = math.max(rawLongStop,  close - atr * i_maxRiskATR)
shortStop = math.min(rawShortStop, close + atr * i_maxRiskATR)

longRR  = (close - longStop)  > 0 ? (longTgt - close)  / (close - longStop)  : 0.0
shortRR = (shortStop - close) > 0 ? (close - shortTgt) / (shortStop - close) : 0.0

// Positive gamma suppresses continuation into a wall — don't buy the ceiling.
blockLong  = i_regimeF and posGamma and not na(dRes) and dRes < 0.4
blockShort = i_regimeF and posGamma and not na(dSup) and dSup < 0.4

// 0DTE pin: in positive gamma, late session, parked on the control node, price
// usually stays there. Those entries pay the spread and go nowhere.
lateSession = inRth and rthBar > rthTotal * 0.6
pinned = i_pinGuard and posGamma and hasGex and lateSession
     and not na(cnLvl) and atr > 0 and math.abs(close - cnLvl) < atr * 0.35

var int lastSig = -1000
canFire = i_sigOn and sessionOk and openOk and eodOk and barstate.isconfirmed
     and (bar_index - lastSig) > i_cooldown and not pinned

// A trade needs a confident lean AND enough separate confluences behind it —
// one dominant weight shouldn't be able to carry a signal on its own.
buySig  = canFire and score > 0 and confidence >= i_minConf and nAgree >= i_minAgree
     and longRR >= i_minRR and not blockLong
sellSig = canFire and score < 0 and confidence >= i_minConf and nAgree >= i_minAgree
     and shortRR >= i_minRR and not blockShort

if buySig or sellSig
    lastSig := bar_index

// =============================================================================
//  Trade manager — entry, stop, targets, exit
// =============================================================================
var int   tDir    = 0        // 0 flat, 1 long, -1 short
var float tEntry  = na
var float tStop   = na
var float tTp1    = na
var float tTp2    = na
var float tRisk   = na       // initial risk per unit, for R multiples
var int   tBar    = na
var bool  tTp1Hit = false

var int   nWin = 0
var int   nLoss = 0
var float sumR = 0.0
if newDay
    nWin := 0
    nLoss := 0
    sumR := 0.0

// Only one position at a time — these are 5m intraday signals, not a portfolio.
flat = tDir == 0
openLong  = flat and buySig  and i_manageOn
openShort = flat and sellSig and i_manageOn

if openLong
    tDir := 1
    tEntry := close
    tStop := longStop
    tTp1 := longTgt
    tTp2 := na(longTp2) ? longTgt + atr : longTp2
    tRisk := math.max(close - longStop, syminfo.mintick)
    tBar := bar_index
    tTp1Hit := false
if openShort
    tDir := -1
    tEntry := close
    tStop := shortStop
    tTp1 := shortTgt
    tTp2 := na(shortTp2) ? shortTgt - atr : shortTp2
    tRisk := math.max(shortStop - close, syminfo.mintick)
    tBar := bar_index
    tTp1Hit := false

// Resolve an open trade. Stop is checked before target: if a bar spans both we
// cannot know which came first intrabar, so assume the loss.
string exitReason = na
float  exitPrice  = na
float  exitR      = na   // captured here; the drawing block clears the trade state

if tDir != 0 and not openLong and not openShort
    isLong = tDir == 1
    hitStop = isLong ? low <= tStop : high >= tStop
    hitTp2  = isLong ? high >= tTp2 : low <= tTp2
    hitTp1  = isLong ? high >= tTp1 : low <= tTp1

    if hitStop
        exitReason := tTp1Hit and i_beAtTp1 ? "BE" : "STOP"
        exitPrice := tStop
    else if hitTp2
        exitReason := "TP2"
        exitPrice := tTp2
    else
        if hitTp1 and not tTp1Hit
            tTp1Hit := true
            if i_beAtTp1
                tStop := tEntry          // risk removed, let TP2 run
        if i_exitFlip and barstate.isconfirmed
             and ((isLong and score <= -thrScore) or (not isLong and score >= thrScore))
            exitReason := "FLIP"
            exitPrice := close
        // 0DTE contracts decay to nothing overnight — never hold past the close.
        if i_exitEOD and inRth and rthBar >= rthTotal - i_skipEOD and na(exitReason)
            exitReason := "EOD"
            exitPrice := close

if not na(exitReason)
    exitR := tDir == 1 ? (exitPrice - tEntry) / tRisk : (tEntry - exitPrice) / tRisk
    sumR += exitR
    if exitR > 0
        nWin += 1
    else
        nLoss += 1

// =============================================================================
//  Drawing — levels
// =============================================================================
f_ray(float price, color col, int width, bool show, string txt) =>
    var line  glow = na
    var line  core = na
    var label tag  = na
    if barstate.islast
        line.delete(glow)
        line.delete(core)
        label.delete(tag)
        if show and not na(price)
            x1 = bar_index - i_back
            x2 = bar_index + i_fwd
            glow := line.new(x1, price, x2, price, color = color.new(col, 78), width = width + 4)
            core := line.new(x1, price, x2, price, color = col, width = width)
            tag  := label.new(x2, price, txt + "  " + str.tostring(price, format.mintick),
                 style = label.style_label_left, color = color.new(col, 15),
                 textcolor = color.white, size = size.small)

f_ray(flipLvl, c_flip, 2, i_showFlip and not na(flipLvl), hasGex ? "FLIP" : "VWAP")
f_ray(cwLvl,   c_call, 3, i_showWall and not na(cwLvl),   hasGex ? "CALL WALL" : "PDH")
f_ray(pwLvl,   c_put,  3, i_showWall and not na(pwLvl),   hasGex ? "PUT WALL"  : "PDL")
f_ray(gexCW2,  c_call, 1, i_showWall and not i_minimal and not na(gexCW2),  "CALL W2")
f_ray(gexPW2,  c_put,  1, i_showWall and not i_minimal and not na(gexPW2),  "PUT W2")
f_ray(cnLvl,   c_node, 2, i_showNode and not na(cnLvl),   hasGex ? "CONTROL NODE" : "POC")

f_ray(emUp, color.new(c_call, 40), 1, i_showEM and not i_minimal and not na(emUp), "EM +")
f_ray(emDn, color.new(c_put,  40), 1, i_showEM and not i_minimal and not na(emDn), "EM −")

// Auto extras
f_ray(pdh,  color.new(color.gray, 20), 1, i_showPDHL and not hasGex and not na(pdh), "PDH")
f_ray(pdl,  color.new(color.gray, 20), 1, i_showPDHL and not hasGex and not na(pdl), "PDL")
f_ray(onh,  color.new(color.teal, 20), 1, i_showONHL and not i_minimal and not na(onh), "ONH")
f_ray(onl,  color.new(color.teal, 20), 1, i_showONHL and not i_minimal and not na(onl), "ONL")

plot(i_showVWAP ? vwap : na, "VWAP", color.new(color.orange, 20), 1)
plot(i_showVWAP and not i_minimal ? vwap + vwapSd : na, "VWAP +1σ", color.new(color.orange, 70), 1)
plot(i_showVWAP and not i_minimal ? vwap - vwapSd : na, "VWAP −1σ", color.new(color.orange, 70), 1)

// Per-strike profile rays, width scaled by |GEX| — the panel from the screenshot
var line[] profLines = array.new<line>()
if barstate.islast and i_profShow and not i_minimal and array.size(pStrike) > 0
    if array.size(profLines) > 0
        for i = 0 to array.size(profLines) - 1
            line.delete(array.get(profLines, i))
        array.clear(profLines)
    for i = 0 to array.size(pStrike) - 1
        s = array.get(pStrike, i)
        g = array.get(pGex, i)
        mag = pMaxAbs > 0 ? math.abs(g) / pMaxAbs : 0.0
        int w = math.max(1, int(math.round(mag * i_profWidth)))
        c = color.new(g >= 0 ? c_call : c_put, int(math.round(85 - mag * 55)))
        array.push(profLines, line.new(bar_index - i_back, s, bar_index + i_fwd, s, color = c, width = w))

// =============================================================================
//  Drawing — signals
// =============================================================================
plotshape(buySig,  "BUY",  shape.triangleup,   location.belowbar, color.new(#00e676, 0), size = size.small)
plotshape(sellSig, "SELL", shape.triangledown, location.abovebar, color.new(#ff1744, 0), size = size.small)

f_sigText(bool isLong, float tgt, float stp, float rr) =>
    (isLong ? "BUY" : "SELL") + "  " + str.tostring(close, format.mintick) +
     "\ntgt " + str.tostring(tgt, format.mintick) +
     "  stop " + str.tostring(stp, format.mintick) +
     "\nR " + str.tostring(rr, "#.##") + "  · " + (posGamma ? "γ+" : negGamma ? "γ−" : "γ?") +
     "  RVOL " + str.tostring(rvol, "#.#")

if buySig
    label.new(bar_index, low, f_sigText(true, longTgt, longStop, longRR),
         style = label.style_label_up, color = color.new(#00e676, 20),
         textcolor = color.black, size = size.small)
    if i_drawProj and not i_manageOn
        line.new(bar_index, close, bar_index + i_fwd, longTgt,
             color = color.new(#00e676, 30), width = 1, style = line.style_dashed)
if sellSig
    label.new(bar_index, high, f_sigText(false, shortTgt, shortStop, shortRR),
         style = label.style_label_down, color = color.new(#ff1744, 20),
         textcolor = color.white, size = size.small)
    if i_drawProj and not i_manageOn
        line.new(bar_index, close, bar_index + i_fwd, shortTgt,
             color = color.new(#ff1744, 30), width = 1, style = line.style_dashed)

// =============================================================================
//  Drawing — active trade
// =============================================================================
C_WIN  = #00e676
C_LOSS = #ff1744

var box  bRisk  = na
var box  bRew   = na
var line lEntry = na
var line lStop  = na
var line lTp1   = na
var line lTp2   = na

if openLong or openShort
    isLong = openLong
    rTop = isLong ? tEntry : tStop
    rBot = isLong ? tStop  : tEntry
    wTop = isLong ? tTp1   : tEntry
    wBot = isLong ? tEntry : tTp1
    bRisk := box.new(bar_index, rTop, bar_index + 2, rBot,
         border_color = color.new(C_LOSS, 55), bgcolor = color.new(C_LOSS, 88))
    bRew := box.new(bar_index, wTop, bar_index + 2, wBot,
         border_color = color.new(C_WIN, 55), bgcolor = color.new(C_WIN, 88))
    lEntry := line.new(bar_index, tEntry, bar_index + 2, tEntry,
         color = color.new(color.white, 20), width = 2)
    lStop := line.new(bar_index, tStop, bar_index + 2, tStop,
         color = C_LOSS, width = 1, style = line.style_dashed)
    lTp1 := line.new(bar_index, tTp1, bar_index + 2, tTp1, color = C_WIN, width = 1)
    lTp2 := line.new(bar_index, tTp2, bar_index + 2, tTp2,
         color = color.new(C_WIN, 40), width = 1, style = line.style_dotted)
    label.new(bar_index, tEntry,
         (isLong ? "▲ LONG " : "▼ SHORT ") + str.tostring(tEntry, format.mintick) +
         "\nstop " + str.tostring(tStop, format.mintick) +
         "\ntp1 "  + str.tostring(tTp1, format.mintick) +
         "  (" + str.tostring(math.abs(tTp1 - tEntry) / tRisk, "#.#") + "R)" +
         "\ntp2 "  + str.tostring(tTp2, format.mintick),
         style = isLong ? label.style_label_upper_right : label.style_label_lower_right,
         color = color.new(isLong ? C_WIN : C_LOSS, 15),
         textcolor = isLong ? color.black : color.white, size = size.small)

// Stretch the live trade's drawings to the current bar.
if tDir != 0 and not na(bRisk)
    box.set_right(bRisk, bar_index + 2)
    box.set_right(bRew, bar_index + 2)
    line.set_x2(lEntry, bar_index + 2)
    line.set_x2(lStop, bar_index + 2)
    line.set_x2(lTp1, bar_index + 2)
    line.set_x2(lTp2, bar_index + 2)
    // the stop line follows a breakeven move
    line.set_y1(lStop, tStop)
    line.set_y2(lStop, tStop)
    if tTp1Hit
        line.set_color(lStop, color.new(color.gray, 30))

if not na(exitReason)
    won = exitR > 0
    label.new(bar_index, exitPrice,
         "✕ " + exitReason + "  " + str.tostring(exitR, "+#.##;-#.##") + "R",
         style = label.style_label_left,
         color = color.new(won ? C_WIN : C_LOSS, 15),
         textcolor = won ? color.black : color.white, size = size.small)
    if not na(bRisk)
        box.set_right(bRisk, bar_index)
        box.set_right(bRew, bar_index)
        line.set_x2(lEntry, bar_index)
        line.set_x2(lStop, bar_index)
        line.set_x2(lTp1, bar_index)
        line.set_x2(lTp2, bar_index)
    // flat again
    tDir := 0
    tEntry := na
    tStop := na
    tTp1 := na
    tTp2 := na
    tTp1Hit := false

// =============================================================================
//  HUD — one compact card: what the confluences say, and where price can go
// =============================================================================
f_meter(int pct) =>
    int filled = int(math.round(pct / 10.0))
    string s = ""
    for i = 1 to 10
        s := s + (i <= filled ? "█" : "░")
    s

// The confluences currently voting, strongest first is not worth a sort here —
// declaration order already runs roughly most- to least-structural.
f_confList() =>
    string s = ""
    int shown = 0
    if array.size(cVotes) > 0
        for i = 0 to array.size(cVotes) - 1
            v = array.get(cVotes, i)
            if math.abs(v) > 0.15 and shown < 8
                s := s + (v > 0 ? "▲ " : "▼ ") + array.get(cNames, i) + "\n"
                shown += 1
    s == "" ? "no confluence active" : str.substring(s, 0, str.length(s) - 1)

if i_hud and barstate.islast
    waiting = confidence < i_minConf or nAgree < i_minAgree
    dirTxt  = waiting ? "◆  WAIT" : score > 0 ? "▲  LONG BIAS" : "▼  SHORT BIAS"
    dirCol  = waiting ? color.gray : score > 0 ? C_WIN : C_LOSS

    int rows = i_hudDetail ? 7 : 6
    var table t = table.new(position.top_right, 1, 7, border_width = 0,
         frame_color = color.new(color.gray, 60), frame_width = 1)

    // headline: direction + confidence
    table.cell(t, 0, 0, dirTxt + "     " + str.tostring(confidence) + "%",
         text_color = waiting ? color.silver : color.black,
         bgcolor = color.new(dirCol, waiting ? 80 : 10),
         text_size = size.normal, text_halign = text.align_left)

    // confidence meter + grade
    table.cell(t, 0, 1, f_meter(confidence) + "   " + grade + " · " +
         str.tostring(nAgree) + "/" + str.tostring(array.size(cVotes)) + " agree",
         text_color = dirCol, bgcolor = color.new(color.black, 85),
         text_size = size.small, text_halign = text.align_left)

    // regime
    table.cell(t, 0, 2, regime,
         text_color = not hasGex ? color.gray : posGamma ? c_call : c_put,
         bgcolor = color.new(color.black, 85), text_size = size.tiny, text_halign = text.align_left)

    // the path: nearest level each way
    table.cell(t, 0, 3,
         "↑ " + (na(resLvl) ? "—" : str.tostring(resLvl, format.mintick)) +
         "     ↓ " + (na(supLvl) ? "—" : str.tostring(supLvl, format.mintick)),
         text_color = color.silver, bgcolor = color.new(color.black, 85),
         text_size = size.tiny, text_halign = text.align_left)

    // magnet
    table.cell(t, 0, 4,
         "magnet " + (na(magnet) ? "—" : str.tostring(magnet, format.mintick)) +
         "  " + (magnetPull > 0.05 ? "↑" : magnetPull < -0.05 ? "↓" : "•") +
         "     rvol " + str.tostring(rvol, "#.#") + "×",
         text_color = c_node, bgcolor = color.new(color.black, 85),
         text_size = size.tiny, text_halign = text.align_left)

    // data source — states outright whether real GEX is loaded
    table.cell(t, 0, 5, hasGex ? "● GEX levels loaded" : "○ auto levels — no GEX blob",
         text_color = hasGex ? c_node : color.gray, bgcolor = color.new(color.black, 85),
         text_size = size.tiny, text_halign = text.align_left)

    table.cell(t, 0, 6, i_hudDetail ? f_confList() : "",
         text_color = color.silver, bgcolor = color.new(color.black, i_hudDetail ? 85 : 100),
         text_size = size.tiny, text_halign = text.align_left)
// Session scorecard — today's closed trades only, reset each day.
if i_showStats and i_manageOn and barstate.islast
    var table st = table.new(position.bottom_right, 2, 4, border_width = 1)
    nTot = nWin + nLoss
    table.cell(st, 0, 0, "TRADES", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(st, 1, 0, str.tostring(nTot) + (tDir != 0 ? "  (1 open)" : ""),
         text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)
    table.cell(st, 0, 1, "W / L", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(st, 1, 1, str.tostring(nWin) + " / " + str.tostring(nLoss),
         text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)
    table.cell(st, 0, 2, "WIN RATE", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(st, 1, 2, nTot > 0 ? str.tostring(100.0 * nWin / nTot, "#.#") + "%" : "—",
         text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)
    table.cell(st, 0, 3, "TOTAL R", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.cell(st, 1, 3, str.tostring(sumR, "+#.##;-#.##"),
         text_color = sumR >= 0 ? #00e676 : #ff1744, text_size = size.tiny, text_halign = text.align_right)

// =============================================================================
//  Alerts
// =============================================================================
alertcondition(buySig,  "ITM·GEX Buy",  "BUY {{ticker}} @ {{close}}")
alertcondition(sellSig, "ITM·GEX Sell", "SELL {{ticker}} @ {{close}}")
alertcondition(not na(exitReason), "ITM·GEX Exit", "EXIT {{ticker}} @ {{close}}")

if not na(exitReason)
    alert("EXIT " + syminfo.ticker + " (" + exitReason + ") @ " +
         str.tostring(exitPrice, format.mintick) + " | " +
         str.tostring(exitR, "+#.##;-#.##") + "R", alert.freq_once_per_bar_close)

if buySig
    alert("BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) +
         " | tgt " + str.tostring(longTgt, format.mintick) +
         " | stop " + str.tostring(longStop, format.mintick) +
         " | R " + str.tostring(longRR, "#.##") + " | " + regime, alert.freq_once_per_bar_close)
if sellSig
    alert("SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) +
         " | tgt " + str.tostring(shortTgt, format.mintick) +
         " | stop " + str.tostring(shortStop, format.mintick) +
         " | R " + str.tostring(shortRR, "#.##") + " | " + regime, alert.freq_once_per_bar_close)
